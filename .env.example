# ===== 大语言模型（千问 OpenAI 兼容接口）=====
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-qwen-api-key-here
LLM_TEMPERATURE=0.7
# 轻量模型（用于情感分析/路由判断/信息抽取等辅助任务，降低延迟）
# 留空则回退到 LLM_MODEL；推荐使用 qwen-turbo 等快速模型
LLM_LITE_MODEL=qwen-turbo
LLM_JUDGE_MODEL=qwen-plus
# 备用模型列表（主模型失败时按优先级依次尝试，逗号分隔）
# 留空则使用默认降级模型 qwen-turbo
LLM_FALLBACK_MODELS=qwen-turbo,qwen-plus

# ===== Embedding 模型（纯文本向量检索）=====
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu

# ===== 向量库 =====
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION=dingtalk_kb
RAG_TOP_K=4
RAG_SCORE_FILTER=1.2
# 文档切片大小与重叠（字符数，调整后需 python -m rag.ingest --rebuild 重建索引）
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
# 知识文档存放目录（相对路径基于项目根目录，支持绝对路径）
RAG_DOCS_DIR=data/docs

# ===== 重排序（Reranker）=====
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_DEVICE=cpu
RERANK_CANDIDATE_COUNT=20
RERANK_TOP_K=4

# ===== 联网搜索 =====
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT=10

# ===== OCR 配置 =====
OCR_LANGUAGES=ch_sim,en
OCR_USE_GPU=false
OCR_MIN_TEXT_LENGTH=50

# ===== 支持的文件扩展名 =====
SUPPORTED_FILE_EXTENSIONS=.txt,.md,.pdf,.docx,.xlsx,.png,.jpg,.jpeg,.bmp,.tiff

# ===== 记忆系统 =====
LONG_TERM_DB_PATH=data/memory.db
MEMORY_SUMMARY_EVERY=6
# 长期记忆上下文字符预算（画像/关键事实硬保留，摘要层按预算填充）
MEMORY_CONTEXT_BUDGET=1600
# 短期历史窗口（注入生成的最近消息条数）
MEMORY_SHORT_WINDOW=8
# 短期历史字符预算（超预算从最旧消息丢弃）
MEMORY_HISTORY_BUDGET=2000
# RAG/联网搜索上下文字符预算
RAG_CONTEXT_BUDGET=2500
# 每轮 LLM 结构化抽取开关（规则快速抽取始终启用）
MEMORY_EXTRACT_LLM_ENABLED=true
# 问答记忆缓存：相似问题直接复用历史答案，跳过大模型
MEMORY_QA_CACHE_ENABLED=true
# 问答记忆命中的余弦相似度阈值（越高越严格）
MEMORY_QA_THRESHOLD=0.90
# 每用户最多保留的问答记忆条数
MEMORY_QA_MAX_RECORDS=200

# ===== 钉钉企业应用 / 机器人 =====
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_ROBOT_TOKEN=
DINGTALK_ROBOT_SECRET=
DINGTALK_ROBOT_CODE=
DINGTALK_API_BASE=https://oapi.dingtalk.com

# ===== 钉钉工具调用（待办/会议管理）=====
# 工具调用总开关（关闭后 tool 路由自动降级为 chat）
TOOL_CALLING_ENABLED=false
# 写操作（创建/取消/修改）需用户确认
TOOL_CONFIRMATION_REQUIRED=true

# ===== LangSmith 评估与追踪 =====
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dingtalk-ai-agent
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://smith.langchain.com
